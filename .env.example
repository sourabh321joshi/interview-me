# Copy this file to .env.local and fill it in. Never commit .env.local.
# Keep each value on one line with no spaces around "=" and no comment after the value.

# Database (required)
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER-HOST/?retryWrites=true&w=majority
MONGODB_DB=interview_app

# Provider (OpenAI by default; choose Gemini explicitly for synthetic-data testing only).
# LLM_PROVIDER=openai

# OpenAI. Use exact model names your account can use when LLM_PROVIDER=openai.
OPENAI_API_KEY=
MODEL_PLAN=
MODEL_TURN=
MODEL_REPORT=

# Gemini. Set LLM_PROVIDER=gemini and configure a model before using app routes.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.1-flash-lite
# Or override by role: GEMINI_MODEL_PLAN=..., GEMINI_MODEL_TURN=..., GEMINI_MODEL_REPORT=..., GEMINI_MODEL_PROFILE=...
# The isolated report smoke test only needs GEMINI_API_KEY; it does not depend on LLM_PROVIDER.
# Optional report smoke-test override; defaults to gemini-3.1-flash-lite.
# GEMINI_MODEL_REPORT=gemini-3.1-flash-lite
# For diagnose:gemini-report, set GEMINI_DIAGNOSTIC_INTERVIEW_ID to an existing synthetic interview id.

# Optional: model for resume and GitHub parsing. Falls back to MODEL_TURN when empty or missing.
# MODEL_PROFILE=

# Optional: prices in USD per 1M tokens so cost estimates are not zero.
# MODEL_PRICES_JSON={"model-name":{"input":0.2,"cached_input":0.02,"output":1.25}}

# Optional: GitHub token for higher API limits when reading repositories.
# GITHUB_TOKEN=

# Limits. Raise these while testing.
FREE_INTERVIEW_LIMIT=100
RATE_GENERAL_PER_MINUTE=120
RATE_PROFILES_PER_DAY=100
